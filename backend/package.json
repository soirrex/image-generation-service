{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" && npx prisma format",
    "dev": "node --import jiti/register --watch --watch-path=src src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=src/",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules npx jest --runInBand --testPathPatterns=tests/ --forceExit",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "inversify": "^8.2.3",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
